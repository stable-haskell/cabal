cabal-version: 2.4
-- Sort after both "async-…" and the macOS vowel-compressed unit id
-- "sync-…". This package and async are both initially ready, and the
-- install plan lists them in unit-id order. "subonly" sits between
-- those two spellings, so the haddock-project golden flipped on macOS.
name: zsubonly
version: 0.1.0.0
build-type: Simple

library nested
    exposed-modules:  SubOnly
    build-depends:    base
    hs-source-dirs:   .
    default-language: Haskell2010
