cabal-version: 3.0
name: profiling-target-abi
version: 0.1
build-type: Simple

library
  exposed-modules: ProfileTarget
  other-modules: TargetLayout
  hs-source-dirs: src
  c-sources: cbits/profiling.c
  build-depends: base, template-haskell
  build-tool-depends: ordinary-preprocessor:ordinary-preprocessor
  ghc-options: -F -pgmF ordinary-preprocessor
  ghc-prof-options: -fprof-cafs
  default-language: Haskell2010

executable profile-target
  main-is: Main.hs
  hs-source-dirs: app
  build-depends: base, profiling-target-abi
  ghc-options: -rtsopts
  default-language: Haskell2010
