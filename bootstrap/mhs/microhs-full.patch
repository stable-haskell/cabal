+derSemigroup :: Deriver
+derSemigroup mctx 0 lhs cs@[c@(Constr _ _ con _ _)] esem = do
+  hdr <- mkHdr mctx lhs cs esem
+  let loc = getSLoc esem
+      (xp, xs) = mkPat c "x$"
+      (yp, ys) = mkPat c "y$"
+      eAppend = eAppI2 (mkBuiltin loc "<>")
+      rhs = tApps con (zipWith eAppend xs ys)
+      iAppend = mkIdentSLoc loc "<>"
+      inst = Instance hdr [Fcn iAppend [eEqn [xp, yp] rhs]] []
+  return [inst]
+derSemigroup _ _ lhs _ e = cannotDerive lhs e
+
+derMonoid :: Deriver
+derMonoid mctx 0 lhs cs@[c@(Constr _ _ con _ _)] emon = do
+  hdr <- mkHdr mctx lhs cs emon
+  let loc = getSLoc emon
+      (_, xs) = mkPat c "x$"
+      eMempty = EVar (mkIdentSLoc loc "mempty")
+      rhs = tApps con (map (const eMempty) xs)
+      iMempty = mkIdentSLoc loc "mempty"
+      inst = Instance hdr [Fcn iMempty [eEqn [] rhs]] []
+  return [inst]
+derMonoid _ _ lhs _ e = cannotDerive lhs e
+
+--------------------------------------------
+
 derOrd :: Deriver
 derOrd mctx 0 lhs cs eord = do
   hdr <- mkHdr mctx lhs cs eord
