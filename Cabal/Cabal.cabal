-- Process capture regression tests: dual-backend (GHC reference and
-- MicroHs) coverage for Distribution.Compat.Process capture
-- discipline, environment replacement, locale-correct text handling
-- and explicit CreatePipe rejection.  POSIX-only: the tests drive
-- @sh@/@env@/@cat@.  The same Main.hs also compiles directly with
-- @mhs@ (see the module header for the exact command).
test-suite process-capture-tests
  type: exitcode-stdio-1.0
  hs-source-dirs: tests
  main-is: ProcessCaptureTests.hs
  -- POSIX-only: the tests drive sh/env/cat.
  if !(os(linux) || os(darwin))
    buildable: False
  default-language: GHC2021
  ghc-options: -Wall
  build-depends:
    , base       >= 4.17 && < 5
    , bytestring >= 0.10.0.0 && < 0.13
    , Cabal      ^>= 3.19
