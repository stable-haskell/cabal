cabal-version: 3.8
name:          Cabal
version:       3.19.0.0
copyright:     2003-2026, Cabal Development Team (see AUTHORS file)
license:       BSD-3-Clause
license-file:  LICENSE
author:        Cabal Development Team <cabal-devel@haskell.org>
maintainer:    cabal-devel@haskell.org
homepage:      http://www.haskell.org/cabal/
bug-reports:   https://github.com/haskell/cabal/issues
synopsis:      A framework for packaging Haskell software
description:
  The Haskell Common Architecture for Building Applications and
  Libraries: a framework defining a common interface for authors to more
  easily build their Haskell applications in a portable way.

  The Haskell Cabal is part of a larger infrastructure for distributing,
  organizing, and cataloging Haskell libraries and tools.
category:       Distribution
build-type:     Simple
-- If we use a new Cabal feature, this needs to be changed to Custom so
-- we can bootstrap.

extra-doc-files:
  README.md ChangeLog.md

extra-source-files:
  cbits/mhs_spawn.h
  cbits/mhs_handle.h

source-repository head
  type:     git
  location: https://github.com/haskell/cabal/
  subdir:   Cabal

flag git-rev
  description: include Git revision hash in version
  default: False
  manual: True

flag mhs
  description: MicroHs build (uses -mhs package variants for array/binary/pretty)
  default:     False
  manual:      True

library
  default-language: GHC2021
  -- Disabling ImportQualifiedPost, otherwise fourmolu jumps ahead to apply it everywhere
  default-extensions: NoImportQualifiedPost
  hs-source-dirs: src

  -- C helpers for the MHS (MicroHs) build, which cannot use the
  -- @process@ package.  The POSIX bodies are used there; other
  -- platforms compile the stubs.  The matching headers
  -- (cbits/mhs_spawn.h and cbits/mhs_handle.h, shipped in
  -- extra-source-files) carry the prototypes for MicroHs-generated
  -- FFI call sites.
  c-sources:
    cbits/mhs_spawn.c
    cbits/mhs_handle.c
  include-dirs: cbits

  -- Common deps available as separate MHS packages with the same
  -- bounds on both backends (transformers/mtl/parsec stay in the
  -- unconditional block below; they exist as mtl-2.3.2,
  -- parsec-3.1.18.0, transformers-0.6.2.0 under MHS).
  build-depends:
    , Cabal-syntax ^>= 3.19
    , base       >= 4.18     && < 5
    , containers >= 0.5.8.2  && < 0.9
    , filepath   >= 1.4.301  && < 1.6
    , time       >= 1.4.0.1  && < 1.17

  -- MicroHs ships array/binary/pretty as -mhs variants; base-0.16.12.0
  -- provides bytestring, text, directory, deepseq, process, stm, so
  -- those (plus unix, which has no MHS package) are GHC-only.
  if flag(mhs)
    build-depends:
      array-mhs  >= 0.5.8   && < 0.6,
      binary-mhs >= 0.8.1   && < 0.9,
      pretty-mhs >= 1.1.3.6 && < 1.2
  else
    build-depends:
      , array      >= 0.4.0.1  && < 0.6
      , binary     >= 0.8.1    && < 0.9
      , bytestring >= 0.10.8   && < 0.13
      , deepseq    >= 1.4      && < 1.7
      , directory  >= 1.2.7    && < 1.4
      , pretty     >= 1.1.1    && < 1.2
      , process    >= 1.6.29.0 && < 1.7
      , text       >= 2.0.2    && < 2.2

  -- No unix/Win32 under MHS: base-0.16.12.0 provides System.Directory
  -- and System.Process (via Distribution.Compat.Directory / MhsProcess
  -- shims); unix-only code is behind !__MHS__. os-string-2.0.10 exists
  -- in the MHS package db but Cabal/ has no System.OsString/OsPath
  -- imports, so it is not required.
  if !flag(mhs)
    if os(windows)
      build-depends:
        , Win32 >= 2.4.0.0 && < 2.15
    else
      build-depends:
        , unix  >= 2.8.6.0 && < 2.9

  if flag(git-rev)
    build-depends:
      , githash ^>= 0.1.7.0
    cpp-options: -DGIT_REV

  ghc-options:
    -Wall
    -fno-ignore-asserts
    -Wtabs
    -Wincomplete-uni-patterns
    -Wincomplete-record-updates
    -Wno-unticked-promoted-constructors

  if impl(ghc >= 8.0)
    ghc-options: -Wcompat -Wnoncanonical-monad-instances

  if impl(ghc >= 8.0) && impl(ghc < 8.8)
    ghc-options: -Wnoncanonical-monadfail-instances

  if impl(ghc >= 9.14)
    ghc-options: -Wno-pattern-namespace-specifier -Wno-incomplete-record-selectors

